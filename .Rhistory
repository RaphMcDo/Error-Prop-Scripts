tcv_weight_predictions[[model]][[i]]<-temp_tcv_weight_predictions[[model]][[i]]
}
}
save(tcv_weight_predictions,file="new_tcv_preds_MSPE.RData")
for (model in 1:8){
for (fold in 1:length(unique(sub_mw$ID))){
